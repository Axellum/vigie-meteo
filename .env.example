# --- Configuration générale ---
METEO_ENV=production
METEO_LOG_LEVEL=INFO
METEO_DB_PATH=/data/meteo_cache.db

# --- Sécurité ---
# Clé optionnelle pour protéger votre instance (header X-API-Key ou Authorization: Bearer).
# Laisser vide pour un accès libre en réseau local.
METEO_API_KEY=

# --- Source Open-Meteo (locale sur Oracle ou publique en secours) ---
OPEN_METEO_BASE_URL=http://open-meteo:8080
# URL de secours si le conteneur local n'est pas encore synchronisé (optionnel)
OPEN_METEO_FALLBACK_URL=https://api.open-meteo.com

# --- Source officielle Météo-France (Portail API) ---
# Clé API ou jeton OAuth2 du portail https://portail-api.meteofrance.fr
METEOFRANCE_API_KEY=
# Pluie dans l'heure PIAF (api.meteofrance.fr) ; 18 échéances pour que Vigie ait toujours 12 tranches à venir
METEO_PIAF_STEPS=18

# --- Paramètres de résilience & cache ---
METEO_FORECAST_TTL_SECONDS=900
METEO_NOWCAST_TTL_SECONDS=180
METEO_CIRCUIT_FAIL_THRESHOLD=3
METEO_CIRCUIT_COOLDOWN_SECONDS=120

# --- Identification réseau (bonnes pratiques) ---
METEO_USER_AGENT=meteo-france-api/0.1.0 (self-hosted)
